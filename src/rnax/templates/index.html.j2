<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ config.output.report_title }} - Contrasts Index</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; line-height: 1.6; color: #333; max-width: 800px; margin: 0 auto; padding: 2rem; }
        h1, h2 { color: #2c3e50; border-bottom: 1px solid #eee; padding-bottom: 0.3em; }
        .contrast-list { list-style: none; padding: 0; }
        .contrast-list li { margin: 1rem 0; padding: 1rem; border: 1px solid #ddd; border-radius: 6px; background: #f8f9fa; }
        .contrast-list a { font-size: 1.2rem; font-weight: bold; text-decoration: none; color: #1976d2; }
        .contrast-list a:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <h1>{{ config.output.report_title }}</h1>
    <h2>Analysis Contrasts</h2>
    <ul class="contrast-list">
        {% for contrast in config.contrasts %}
        <li>
            <a href="{{ contrast.name }}/report.html">{{ contrast.name }}</a>
            <p>Comparing <strong>{{ contrast.comparison_level }}</strong> vs <strong>{{ contrast.reference_level }}</strong> (Column: <code>{{ contrast.condition_column }}</code>)</p>
        </li>
        {% endfor %}
    </ul>
</body>
</html>
